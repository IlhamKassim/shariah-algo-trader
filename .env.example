# Alpaca broker credentials
# Paper trading: https://paper-api.alpaca.markets
# Live trading:  https://api.alpaca.markets
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Financial Modeling Prep (market data & fundamentals)
FMP_API_KEY=your_fmp_api_key

# Shariah-compliant ETF whose holdings define the Eligible Universe (e.g. SPUS)
ETF_SYMBOL=SPUS

# Optional: comma-separated list of Shariah ETFs whose combined holdings define
# the Eligible Universe. If unset, defaults to {ETF_SYMBOL, HLAL}.
# Uncomment to opt in to the wider universe. Note: SPWO and UMMA hold mostly
# non-US-listed constituents, which are automatically excluded (Alpaca can
# only execute trades on US-listed securities) — see
# shariah_algo_trader/data/universe.py::_is_us_listed.
# ETF_SYMBOLS=SPUS,HLAL,SPTE,SPRE,SPWO,UMMA

# Number of top-ranked stocks to hold in the Portfolio (equal-weighted at 1/TOP_N each)
TOP_N=20

# Dashboard Authentication Configuration
# Set DASHBOARD_PASSWORD to enable standard console password sign-in.
DASHBOARD_PASSWORD=your_dashboard_password

# Required: master secret used to encrypt/decrypt per-user Alpaca credentials at rest.
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do NOT reuse DASHBOARD_SESSION_SECRET or check a real value into version control.
ENCRYPTION_MASTER_KEY=your_random_encryption_master_key

# Google OAuth2 Authentication (OAuth Sign-In)
# Enable Google login by setting these variables and configuring whitelisted email addresses.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REDIRECT_URI=https://shariahtrading.my/api/auth/google/callback
ALLOWED_GOOGLE_EMAILS=email1@gmail.com,email2@gmail.com

# Supabase Authentication Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Vite Frontend Equivalents (can share same values)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

